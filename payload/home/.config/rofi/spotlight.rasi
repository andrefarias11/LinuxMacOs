configuration {
    modi: "drun,filebrowser,window";
    show-icons: true;
    icon-theme: "WhiteSur-dark";
    font: "Inter 12";
    matching: "fuzzy";
    sort: true;
    drun-display-format: "{name}";
    display-drun: "Aplicativos";
    display-filebrowser: "Arquivos";
    display-window: "Janelas";
    kb-mode-next: "Control+Tab";
    kb-mode-previous: "Control+ISO_Left_Tab";
    window-format: "{t}";
    sidebar-mode: true;
    disable-history: false;
}
* {
    background-color: transparent;
    text-color: #f5f5f7;
    border-color: #42434c;
    spacing: 0;
}
window {
    width: 650px;
    location: center;
    anchor: center;
    y-offset: -90px;
    background-color: #222329f7;
    border: 1px;
    border-radius: 18px;
    padding: 10px;
}
mainbox { children: [ inputbar, listview, mode-switcher, textbox-keyboard-hint ]; }
inputbar {
    children: [ prompt, entry ];
    padding: 14px 12px 20px;
    spacing: 13px;
    border: 0 0 1px;
    border-color: #ffffff12;
}
prompt { font: "Inter 14"; text-color: #a4a7b4; }
entry { text-color: #f5f5f7; cursor-color: #79b8ff; font: "Inter 20"; placeholder: "Pesquisar…"; placeholder-color: #a4a7b4; }
listview { lines: 5; columns: 1; fixed-height: false; padding: 10px 0; spacing: 4px; scrollbar: false; }
element { padding: 10px 13px; border-radius: 11px; spacing: 13px; }
element normal.normal { background-color: transparent; }
element selected.normal { background-color: #0a84ff; text-color: #ffffff; }
element-icon { size: 27px; }
element-text { vertical-align: 0.5; }
mode-switcher { spacing: 7px; padding: 9px 0 0; border: 1px 0 0; border-color: #ffffff12; }
button { padding: 8px 10px; border-radius: 9px; text-color: #a4a7b4; font: "Inter 10"; }
button selected { background-color: #ffffff12; text-color: #f5f5f7; }

textbox-keyboard-hint { padding: 10px 10px 2px; font: "Inter 9"; text-color: #a4a7b4; content: "↵ Abrir     Esc Fechar     Ctrl+Tab Alternar categoria"; }
